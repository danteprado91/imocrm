# Banco de dados (Turso ou SQLite local)
# Turso: libsql://<database>.turso.io
# Local: file:./dev.db
DATABASE_URL="file:./dev.db"

# Token de autenticação do Turso (obrigatório apenas para Turso)
TURSO_AUTH_TOKEN=
TURSO_DATABASE_URL=

# Chave secreta para JWT (troque em produção!)
JWT_SECRET="crm-mvp-secret-key-change-in-production"

# URL base do site (usada no sitemap.xml)
SITE_URL="http://localhost:3000"

# Vercel Blob Storage (para upload de imagens em produção)
# Crie um store em https://vercel.com/stores/blob
BLOB_READ_WRITE_TOKEN=
